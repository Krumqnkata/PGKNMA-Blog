# Leave empty during local development: Vite proxies /api and /files to Django.
# In production set this only when the API is hosted on a different origin.
VITE_API_BASE_URL=
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key-here
